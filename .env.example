# Session + encryption secrets (use long random strings in production)
AUTH_SECRET=change-me-to-a-long-random-string
ENCRYPTION_SECRET=change-me-to-another-long-random-string

# Public HTTPS app URL in production (used for PayPal return/cancel and webhook URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Email Service sender from an onboarded sending domain
EMAIL_FROM=Paymug <updates@paymug.co>
EMAIL_REPLY_TO=support@paymug.co

# GitHub OAuth App used for private-repository product delivery
# Callback URL: http://localhost:3000/api/github/oauth/callback
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Payment gateway credentials (read from the environment; never saved to the DB)
# Use the dashboard only to choose which provider is active at checkout.
# PayPal webhooks are created automatically from the dashboard — no webhook ID is needed.

# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# PAYPAL_LIVE_CLIENT_ID=
# PAYPAL_LIVE_CLIENT_SECRET=
# STRIPE_SANDBOX_SECRET_KEY=
# STRIPE_SANDBOX_WEBHOOK_SECRET=
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_LIVE_WEBHOOK_SECRET=
